# Ignore node modules (EAS installs them itself)
node_modules

# Ignore macOS, Windows, and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore backend folder (since it’s separate)
../SpeechRecognition/
backend/
server/
api/
env/
__pycache__/

# Ignore local environment files
.env
.env.local
.env.development
.env.production

# Ignore test and docs
test/
tests/
__tests__/
docs/
*.md

# Ignore build outputs
build/
dist/
web-build/
.expo/
.expo-shared/

# Ignore images or data you don’t want uploaded
*.zip
*.mp4
*.wav
*.csv
*.onnx

# Optional: ignore logs
npm-debug.log
yarn-debug.log
yarn-error.log
android/
