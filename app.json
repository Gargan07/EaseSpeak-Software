{
  "expo": {
    "name": "EaseSpeak",
    "slug": "EaseSpeak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo1.png",
      "backgroundColor": "#895FFF",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
      "backgroundColor": "#895FFF",
      "barStyle": "light-content",
      "translucent": false
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#895FFF"
      },
      "package": "com.anonymous.EaseSpeak",
      "backgroundColor": "#895FFF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c8edbd6d-bf73-451e-8339-dc84334aac35"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
